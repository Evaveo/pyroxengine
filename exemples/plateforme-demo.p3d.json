            "scripts": [
              {
                "code": "function demarrer(api){\n  const p = api.props();\n  p.pieces = 0; p.vies = 3; p.fini = false;\n  p.total = api.parTag('piece').length;\n  api.statut('Ramasse les ' + p.total + ' pieces, puis rejoins le drapeau');\n\n  api.auContact('piece', function(piece){\n    if(p.fini) return;\n    api.detruire(piece); p.pieces++;\n    api.statut('Pieces : ' + p.pieces + '/' + p.total);\n  });\n\n  api.auContact('ennemi', function(ennemi){\n    if(p.fini) return;\n    // On l'écrase si on lui tombe dessus, il nous coûte une vie sinon.\n    if(api.moi.position.y > ennemi.position.y + 0.3){\n      api.detruire(ennemi); api.rebondir(7); api.statut('Ennemi ecrase !');\n    } else { perdreUneVie(api, 'Aie !'); }\n  });\n\n  api.auContact('but', function(){\n    if(p.fini) return;\n    if(p.pieces >= p.total){ p.fini = true; api.statut('GAGNE ! ' + p.pieces + '/' + p.total + ' pieces'); }\n    else api.statut('Il manque ' + (p.total - p.pieces) + ' piece(s)');\n  });\n}\nfunction perdreUneVie(api, cause){\n  const p = api.props();\n  p.vies--;\n  if(p.vies <= 0){ p.fini = true; api.statut('Perdu — plus de vies'); }\n  else { api.statut(cause + ' Vies restantes : ' + p.vies); api.reapparaitre(); }\n}\nfunction mettreAJour(api){\n  if(api.props().fini) return;\n  const etat = api.deplacerPersonnage({vitesse:7, saut:9.5, gravite:24});\n  if(etat.tombe) perdreUneVie(api, 'Tombe !');\n}",
                "actif": true
              }
            ],
